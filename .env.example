# 기본값은 로컬 실행에 맞춰져 있어 이 파일을 복사하지 않아도 됩니다.
# Podman/컨테이너 안에서 Vite를 실행하는 경우에만 아래 값을 조정하세요.

# VITE_OLLAMA_HOST=http://localhost:11434
# VITE_OLLAMA_HOST=http://host.containers.internal:11434

# 로컬에 설치한 Ollama 비전 모델명입니다.
# VITE_OLLAMA_MODEL=gemma4:e4b

# Cloudflare Pages Functions를 별도로 띄워 /api/analyze를 쓸 때만 필요합니다.
# VITE_FUNCTIONS_HOST=http://localhost:8788
